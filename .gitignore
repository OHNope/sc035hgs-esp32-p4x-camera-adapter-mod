# KiCad local history snapshots
.history/

# KiCad backups, autosaves, locks and caches
*-backups/
fp-info-cache
_autosave-*
*.lck
~*.lck
*.bak
\#auto_saved_files\#

# Per-user editor state (view settings, layer visibility)
*.kicad_prl

# ERC/DRC reports: local check results, CI reruns both
*-erc.rpt
*-drc.rpt
*-erc.json
*-drc.json

# KiBot / release outputs (CI regenerates them)
output/
/*.zip

# kicad-auto machine-local state (never committed)
.kicad-auto/

# OS / editor
.DS_Store
.vscode/
.idea/
